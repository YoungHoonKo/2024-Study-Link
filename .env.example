# 이 파일을 .env로 복사해서 사용하세요. (.env는 Git에 올라가지 않습니다)
# docker compose는 이 두 값만 있으면 됩니다.

# 로컬 MySQL root 비밀번호 (원하는 값으로)
SPRING_DATASOURCE_PASSWORD=studylink-local

# JWT 서명 키: 32바이트 이상 임의 문자열. 아래 명령으로 만들어서 붙여 넣으세요.
#   openssl rand -hex 32
JWT_SECRET=

# 로컬에서 ./gradlew bootRun으로 실행할 때만 필요
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/studylink?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
